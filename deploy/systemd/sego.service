[Unit]
Description=SEGO Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sego
Group=sego
ExecStart=/opt/sego/bin/sego-server --config /etc/sego/sego.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sego /etc/sego
UMask=0027
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
